<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled entirely. The snapshot store holds a record of every app on
  the device and what it can reach; that is exactly the kind of inventory that
  should not be copied off the phone into a cloud backup, even the user's own.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
